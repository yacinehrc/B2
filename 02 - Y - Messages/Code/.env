# Valeurs par défaut, à surcharger dans un .env.local non versionné (jamais de vrai secret ici)

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Base MySQL lancée par Docker (voir compose.yaml), sur le port 3307 pour ne pas gêner un MySQL déjà installé
DATABASE_URL="mysql://ymessages:ymessages@127.0.0.1:3307/y_messages?serverVersion=8.4&charset=utf8mb4"
###< doctrine/doctrine-bundle ###
