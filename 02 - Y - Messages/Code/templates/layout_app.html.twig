{# Mise en page Discord : serveurs | barre latérale | contenu | membres (optionnel) #}
{% extends 'base.html.twig' %}

{% block body %}
{# h-dvh plutôt que h-screen : sur téléphone, la barre d'adresse du navigateur ne cache pas le bas de la page #}
<div class="tw-flex tw-h-dvh tw-overflow-hidden">

    {# Colonnes 1 et 2 : affichées sur ordinateur, tiroir ouvert par le bouton ☰ sur téléphone (offcanvas Bootstrap) #}
    <div id="menu" class="offcanvas-md offcanvas-start tw-flex tw-flex-row tw-shrink-0">

        {# Colonne 1 : la liste des serveurs #}
        <nav class="tw-w-[72px] tw-shrink-0 tw-bg-discord-900 tw-flex tw-flex-col tw-items-center tw-py-3 tw-gap-2 tw-overflow-y-auto">
            {# Bouton "Accueil" = amis + messages privés #}
            <a href="{{ path('app_accueil') }}" title="Messages privés"
               class="bulle-serveur {{ serveur is defined ? '' : 'actif' }}">
                <span class="tw-text-xl tw-font-black">Y</span>
            </a>

            <div class="tw-w-8 tw-h-0.5 tw-bg-discord-600 tw-rounded"></div>

            {% for s in app.user.serveurs %}
                <a href="{{ path('app_serveur_voir', {id: s.id}) }}" title="{{ s.nom }}"
                   class="bulle-serveur {{ serveur is defined and serveur.id == s.id ? 'actif' }}">
                    {{ s.initiales }}
                </a>
            {% endfor %}

            <a href="{{ path('app_serveur_nouveau') }}" title="Créer un serveur" class="bulle-serveur !tw-text-green-500 hover:!tw-text-white hover:!tw-bg-green-600">
                <i class="bi bi-plus-lg tw-text-xl"></i>
            </a>
        </nav>

        {# Colonne 2 : barre latérale + panneau utilisateur #}
        <aside class="tw-w-60 tw-shrink-0 tw-bg-discord-800 tw-flex tw-flex-col">
            <div class="tw-flex-1 tw-overflow-y-auto">
                {% block barre_laterale %}
                    {% include '_partials/_barre_discussions.html.twig' %}
                {% endblock %}
            </div>

            {# Panneau en bas : mon avatar, mon nom, profil et déconnexion #}
            <div class="tw-bg-discord-850 tw-p-2 tw-flex tw-items-center tw-gap-2">
                <a href="{{ path('app_profil') }}" class="tw-flex tw-items-center tw-gap-2 tw-min-w-0 tw-flex-1 text-decoration-none tw-rounded hover:tw-bg-discord-600 tw-p-1">
                    {% include '_partials/_avatar.html.twig' with {utilisateur: app.user, taille: 32} %}
                    <div class="tw-min-w-0 tw-leading-tight">
                        <div class="text-white tw-text-sm tw-font-semibold text-truncate">{{ app.user.nomComplet }}</div>
                        <div class="text-secondary tw-text-xs text-truncate">{{ app.user.identifiant }}</div>
                    </div>
                </a>
                <a href="{{ path('app_profil_modifier') }}" class="btn btn-sm text-secondary" title="Paramètres"><i class="bi bi-gear-fill"></i></a>
                <a href="{{ path('app_deconnexion') }}" class="btn btn-sm text-secondary" title="Se déconnecter"><i class="bi bi-box-arrow-right"></i></a>
            </div>
        </aside>
    </div>

    {# Colonne 3 : le contenu de la page #}
    <main class="tw-flex-1 tw-flex tw-flex-col tw-min-w-0 tw-bg-discord-700">
        {# En-tête commun : le bouton ☰ (téléphone uniquement) puis le contenu du bloc "entete" de la page #}
        <header class="tw-h-12 tw-shrink-0 tw-flex tw-items-center tw-gap-2 tw-px-2 md:tw-px-4 tw-border-b tw-border-black/30 tw-shadow-sm">
            <button type="button" class="btn btn-sm text-secondary d-md-none tw-px-1" data-bs-toggle="offcanvas" data-bs-target="#menu" title="Menu">
                <i class="bi bi-list tw-text-2xl"></i>
            </button>
            {% block entete %}
                <strong class="text-white">Y - Messages</strong>
            {% endblock %}
        </header>

        {% include '_partials/_flash.html.twig' %}
        {% block contenu %}{% endblock %}
    </main>

    {# Colonne 4 (optionnelle) : les membres #}
    {% block colonne_droite %}{% endblock %}
</div>
{% endblock %}
