{# Affiché quand un serveur n'a plus aucun salon #}
{% extends 'layout_app.html.twig' %}

{% block title %}{{ serveur.nom }} - Y - Messages{% endblock %}

{% block barre_laterale %}
    {% include '_partials/_barre_serveur.html.twig' %}
{% endblock %}

{% block entete %}
    <strong class="text-white text-truncate">{{ serveur.nom }}</strong>
    {% include '_partials/_bouton_membres.html.twig' %}
{% endblock %}

{% block contenu %}
    <div class="tw-flex-1 tw-flex tw-flex-col tw-items-center tw-justify-center text-secondary">
        <i class="bi bi-hash tw-text-6xl"></i>
        <p>Ce serveur n'a aucun salon.</p>
        {% if serveur.estProprietaire(app.user) %}
            <a href="{{ path('app_salon_nouveau', {id: serveur.id}) }}" class="btn btn-primary">Créer un salon</a>
        {% endif %}
    </div>
{% endblock %}

{% block colonne_droite %}
    {% include '_partials/_membres_serveur.html.twig' %}
{% endblock %}
