{# Incluse dans la page, puis renvoyée seule toutes les 3 s pour l'auto-refresh #}
{% for message in messages %}
    {# "tw-group" + "group-hover:" : les boutons n'apparaissent qu'au survol du message #}
    <div class="tw-group tw-flex tw-gap-3 tw-py-1.5 tw-px-2 tw-rounded hover:tw-bg-discord-750">
        {% include '_partials/_avatar.html.twig' with {utilisateur: message.auteur, taille: 40} %}

        <div class="tw-min-w-0 tw-flex-1">
            <div class="tw-flex tw-items-baseline tw-gap-2">
                <a href="{{ path('app_profil_voir', {id: message.auteur.id}) }}" class="tw-font-semibold text-white text-decoration-none">
                    {{ message.auteur.nomComplet }}
                </a>
                <small class="text-secondary">{{ message.creeLe|date('d/m/Y à H:i') }}</small>
                {% if message.modifieLe %}
                    <small class="text-secondary fst-italic">(modifié)</small>
                {% endif %}
            </div>
            {# pre-wrap garde les retours à la ligne, et Twig échappe le HTML tout seul #}
            <div class="tw-break-words" style="white-space: pre-wrap;">{{ message.contenu }}</div>
        </div>

        {# Modifier / supprimer : seulement pour MES messages (on compare les id) #}
        {% if message.auteur.id == app.user.id %}
            <div class="tw-flex tw-gap-1 tw-items-start tw-opacity-0 group-hover:tw-opacity-100">
                <a href="{{ path('app_message_modifier', {id: message.id}) }}" class="btn btn-sm btn-dark" title="Modifier">
                    <i class="bi bi-pencil-fill"></i>
                </a>
                <form method="post" action="{{ path('app_message_supprimer', {id: message.id}) }}"
                      onsubmit="return confirm('Supprimer ce message ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('message') }}">
                    <button type="submit" class="btn btn-sm btn-dark text-danger" title="Supprimer">
                        <i class="bi bi-trash-fill"></i>
                    </button>
                </form>
            </div>
        {% endif %}
    </div>
{% else %}
    <div class="tw-text-center text-secondary tw-mt-16">
        <i class="bi bi-chat-dots tw-text-5xl"></i>
        <p class="tw-mt-2">Aucun message pour l'instant. Dis bonjour ! 👋</p>
    </div>
{% endfor %}
